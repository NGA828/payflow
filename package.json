{
  "name": "payflow",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "node scripts/prisma.mjs generate",
    "db:up": "tsx scripts/dev-db.ts",
    "db:migrate": "node scripts/prisma.mjs migrate dev",
    "db:deploy": "node scripts/prisma.mjs migrate deploy",
    "db:seed": "node scripts/prisma.mjs db seed",
    "db:setup": "tsx scripts/db-setup.ts",
    "db:reset": "node scripts/prisma.mjs migrate reset --force",
    "worker": "tsx src/server/jobs/worker.ts",
    "postinstall": "node scripts/prisma.mjs generate"
  },
  "prisma": {
    "schema": "src/prisma/schema.prisma",
    "seed": "tsx src/prisma/seed.ts"
  },
  "overrides": {
    "@prisma/driver-adapter-utils": "6.19.3"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@hookform/resolvers": "^5.2.1",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.14.0",
    "@react-pdf/renderer": "^4.3.0",
    "@tanstack/react-table": "^8.21.3",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.2",
    "big.js": "^6.2.2",
    "bullmq": "^5.57.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "ioredis": "^5.7.0",
    "lucide-react": "^0.542.0",
    "motion": "^13.0.0",
    "next": "^15.5.2",
    "next-auth": "^5.0.0-beta.29",
    "pg": "^8.22.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.62.0",
    "recharts": "^3.1.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.7",
    "@electric-sql/pglite-socket": "^0.0.12",
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/archiver": "^7.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/big.js": "^6.2.2",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.20.4",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "dotenv": "^17.4.2",
    "eslint": "^9.34.0",
    "eslint-config-next": "^15.5.2",
    "pglite-prisma-adapter": "^0.6.1",
    "playwright": "^1.55.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "prisma": "^6.14.0",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
