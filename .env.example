# ── Required ────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://payflow:payflow@localhost:5432/payflow?schema=public"

# Auth.js session secret — generate: openssl rand -base64 32
AUTH_SECRET="replace-me-32-byte-base64"

# AES-256-GCM key for encrypting employee payment details at rest (64 hex chars)
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# Absolute URL of the app (used in emails/links)
APP_URL="http://localhost:3000"

# ── Optional ────────────────────────────────────────────────────────
# Database driver: "pg" (default, real PostgreSQL via DATABASE_URL) or
# "pglite" (embedded PostgreSQL WASM — run PayFlow with zero Docker/servers).
# With pglite, DATABASE_URL is used only by external SQL tooling.
DB_DRIVER="pg"
PGLITE_DATA="./.pglite-data"
DATABASE_POOL_MAX="10"

# Redis for BullMQ background jobs. If unset/unreachable, the inline queue
# driver is used automatically (jobs still execute, in-process).
REDIS_URL="redis://localhost:6379"
QUEUE_DRIVER="auto" # auto | bullmq | inline

# Email: console (log only) | smtp | resend
EMAIL_PROVIDER="console"
EMAIL_FROM="PayFlow <noreply@payflow.test>"
SMTP_HOST="localhost"
SMTP_PORT="1025" # Mailhog (docker compose) — preview at http://localhost:8025
SMTP_USER=""
SMTP_PASS=""
RESEND_API_KEY=""

# Billing adapter: mock | stripe
BILLING_PROVIDER="mock"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# File storage: local driver now, S3-compatible later
STORAGE_DRIVER="local"
STORAGE_DIR="./storage"

# Rate limiting driver: memory | redis
RATE_LIMIT_DRIVER="memory"

# Integration tests database
DATABASE_URL_TEST="postgresql://payflow:payflow@localhost:5432/payflow_test?schema=public"

LOG_LEVEL="info"
SEED_ADMIN_PASSWORD=""
